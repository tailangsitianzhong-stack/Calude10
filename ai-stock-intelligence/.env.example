# ===== AI STOCK INTELLIGENCE 環境変数の例 =====
# このファイルを .env にコピーして値を設定する。.env は Git に含めない。
# ここに書いた値はサーバー側（api / worker）でだけ使われ、ブラウザには送られない。
# 値が空の項目は「未接続」として扱われ、他の機能はそのまま動く。

# --- データベース（Docker Compose の db サービス） ---
POSTGRES_USER=asi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=asi

# --- 日本株：J-Quants API V2（https://jpx-jquants.com/） ---
# ダッシュボードで発行した APIキー（x-api-key ヘッダーで送信。V1のリフレッシュトークンではない）
JQUANTS_API_KEY=
# 契約プラン：free / light / standard / premium（遅延の表示とアクセス間隔に使う。Free は約12週間遅延・5リクエスト/分）
JQUANTS_PLAN=free

# --- 米国株の株価：tiingo または massive（旧 Polygon.io）のどちらかを指定 ---
US_PRICE_PROVIDER=
TIINGO_API_KEY=
MASSIVE_API_KEY=
# Massive の接続先（旧URL api.polygon.io も利用可能とされる）
MASSIVE_BASE_URL=https://api.polygon.io

# --- SEC EDGAR（米国企業の財務データ。キー不要） ---
# SECの規則：アプリ名と連絡先メールアドレスを含める。空のときは仮の値で動き、画面に「仮設定」と表示する
SEC_USER_AGENT=
# 財務データを取得する米国株の数（公開流通時価総額の大きい順）と、必ず含める銘柄
SEC_UNIVERSE_SIZE=150
SEC_EXTRA_TICKERS=KO,PEP,MU,JPM,KDP

# --- FRED（経済指標・金利・為替・指数の終値。キー不要） ---
FRED_API_KEY=

# --- EDINET（日本企業の有価証券報告書。未実装） ---
EDINET_API_KEY=

# --- LLM（説明文の生成。フェーズ5以降） ---
ANTHROPIC_API_KEY=
