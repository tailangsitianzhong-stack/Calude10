# ===== AI STOCK INTELLIGENCE 環境変数の例 =====
# このファイルを .env にコピーして値を設定する。.env は Git に含めない。
# ここに書いた値はサーバー側でだけ使われ、ブラウザには送られない。

# データベース（Docker Compose の db サービスを使う場合の例）
POSTGRES_USER=asi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=asi
DATABASE_URL=postgresql+psycopg://asi:change-me@db:5432/asi

# 株価・財務データのプロバイダー（未設定なら「未接続」と表示される）
JQUANTS_REFRESH_TOKEN=
US_PRICE_PROVIDER=          # フェーズ3で選定（例: polygon / tiingo）
US_PRICE_API_KEY=
EDINET_API_KEY=
SEC_USER_AGENT=             # SECの規則：連絡先を含める（例: "Your Name your@email"）
FRED_API_KEY=               # 任意（未設定でも公開CSVで取得）

# LLM（説明文の生成。フェーズ5以降）
ANTHROPIC_API_KEY=

# 1人用ログイン（フェーズ7で有効化）
APP_LOGIN_PASSWORD_HASH=
SESSION_SECRET=
