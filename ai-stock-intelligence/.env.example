# ===== AI STOCK INTELLIGENCE 環境変数 =====
# このファイルを .env にコピーして値を設定する（.env は Git に含めない）。
# ここの値はサーバー側（api / worker）でだけ使われ、ブラウザには送られない。
# 値が空の項目は「未接続」として扱われ、他の機能はそのまま動く。
# 書式：「名前=値」。値を引用符で囲まない。= の前後に空白を入れない。行末にコメントを書かない。

# ---------- データベース（Docker Compose の db サービス） ----------
POSTGRES_USER=asi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=asi
# Docker を使わずに動かす場合だけ指定（空なら SQLite：backend/data/asi.sqlite3）
# 例 DATABASE_URL=postgresql+psycopg://asi:パスワード@127.0.0.1:5432/asi
DATABASE_URL=

# ---------- 日本株：J-Quants API V2（https://jpx-jquants.com/） ----------
# ダッシュボードで発行した APIキー（x-api-key ヘッダーで送信）。V1 のリフレッシュトークンは使えない
JQUANTS_API_KEY=
# 契約プラン：free / light / standard / premium（Free は約12週間遅延・5リクエスト/分）
JQUANTS_PLAN=free

# ---------- 米国株の株価：tiingo / massive（polygon と書いても同じ）のどれか ----------
US_PRICE_PROVIDER=
TIINGO_API_KEY=
# Massive（旧 Polygon.io）のキー。旧名の POLYGON_API_KEY でも読み込む（両方あれば MASSIVE_API_KEY を優先）
MASSIVE_API_KEY=
# 接続先（空なら https://api.polygon.io）。旧名 POLYGON_BASE_URL も可
MASSIVE_BASE_URL=

# ---------- SEC EDGAR（米国企業の財務データ。キー不要） ----------
# SECの規則：アプリ名と連絡先メールアドレスを含める（例 アプリ名/版 メールアドレス）。
# 空・連絡先なし・例示用ドメインのときは SEC から取得しない（仮の値では接続しない）
SEC_USER_AGENT=
# 財務データを取得する米国株の数（公開流通時価総額の大きい順）と、必ず含める銘柄（カンマ区切り）
SEC_UNIVERSE_SIZE=150
SEC_EXTRA_TICKERS=KO,PEP,MU,JPM,KDP

# ---------- FRED（経済指標・金利・為替・指数の終値） ----------
# 空なら公開CSV（キー不要）。設定すると公式API を使う（キーが無効なら自動で公開CSVに切り替え）
FRED_API_KEY=

# ---------- クラウド環境の「ネットワークシークレット」でキーを渡す場合 ----------
# キーを .env に書かず、Claude Code のクラウド環境の Network secrets に登録したときに指定（カンマ区切り）。
# 例 NETWORK_SECRETS=jquants,tiingo（指定した取得元はアプリから認証ヘッダーを送らず、プロキシが付ける）
NETWORK_SECRETS=

# 日本企業の財務情報（J-Quants）を定期実行で取得するか（既定 false。true にすると worker が未取得の開示日を毎日取得）
JQUANTS_FINS_SCHEDULE=false
JQUANTS_FINS_MAX_DATES=20

# EDINET（金融庁）：日本企業の負債の合計などの補完。キーは URL のパラメータで送る方式のため、環境変数で設定する
EDINET_API_KEY=

# ---------- 将来のフェーズで使う予定（現在は読み込むだけ） ----------
ANTHROPIC_API_KEY=
